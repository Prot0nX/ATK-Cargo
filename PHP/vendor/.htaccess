# جلوگیری از دسترسی مستقیم HTTP به vendor/ — این پوشه شامل کتابخانه‌های
# dev (phpunit، phpstan) است که در وب‌روت کامیت شده‌اند (DEEP_CODE_AUDIT.md
# #Phase1.7 / HIGH). سازگار با Apache 2.2 (mod_access_compat) و 2.4.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
