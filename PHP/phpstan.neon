includes:
    - phpstan-baseline.neon

parameters:
    level: 7
    # هم‌راستا با composer.json (php: >=8.1) — DEEP_CODE_AUDIT.md #Phase2.10.
    phpVersion: 80100
    paths:
        - src
        - api
        # پنل مدیریت لایسنس — کد واقعی است و باید مثل بقیه آنالیز شود.
        - Lic
        # فایل‌های ریشه‌ی PHP/ — پنل‌های مدیریتی و shimهای مستقل که قبلاً از آنالیز جا افتاده بودند (DEEP_CODE_AUDIT.md فاز۳ #۳۱)
        - scripts
        - User
        - config
        - PermissionManager.php
        - SessionManager.php
        - check_signature.php
        - check_update.php
        - export_schema.php
        - file_manager.php
        - get_csrf_token.php
        - get_license_info.php
        - jdf.php
        - update_config.php
        - validate_license.php
    excludePaths:
        - vendor/*
    tmpDir: build/phpstan
    # این پروژه از یک autoloader سفارشی/legacy برای برخی توابع و کلاس‌ها
    # استفاده می‌کند که با PSR-4 بارگذاری نمی‌شوند (jdate در jdf.php،
    # SessionManager سراسری) — این‌ها فقط برای scan (نه اجرا) کافی‌اند.
    scanFiles:
        - jdf.php
        - SessionManager.php
    # APP_ROOT/UPDATE_CHECK_API_KEY با define() و مقدار دینامیک (نه رشته‌ی
    # لفظی) در bootstrap.php/config.php تعریف می‌شوند؛ scanFiles برای این‌ها
    # کافی نیست (فقط define با مقدار literal را می‌فهمد). bootstrap.php
    # امن است برای اجرای واقعی در زمان آنالیز چون فقط autoload/timezone/ثابت‌ها
    # را تنظیم می‌کند، هیچ اتصال دیتابیسی برقرار نمی‌کند.
    bootstrapFiles:
        - src/bootstrap.php
    # UPDATE_CHECK_API_KEY مقداردهی‌اش به .env محیط اجرا وابسته است — در نبود
    # .env مقدار '' می‌شود، پس === '' در checkUpdate رفتار درست و عمدی است
    # (S-13: در نبود پیکربندی، دسترسی رد شود، نه fallback ساکت)، نه یک باگ.
    # نکته‌ی فاز۳ #۳۱: قانون ignore قبلی این خط دیگر با نسخه‌ی نصب‌شده‌ی
    # phpstan/nikic-php-parser (پس از composer install اول این پروژه) match
    # نمی‌شود — نوع UPDATE_CHECK_API_KEY دیگر به رشته‌ی لفظی '' باریک نمی‌شود،
    # پس PHPStan خودش دیگر این خط را «همیشه-ثابت» گزارش نمی‌کند و ignore
    # اضافه‌ای لازم نیست (طبق همان اصل که در نکته‌ی Phase3 #21 بالا مستند شده).
