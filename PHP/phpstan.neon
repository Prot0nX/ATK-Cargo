includes:
    - phpstan-baseline.neon

parameters:
    level: 7
    # تنظیم نسخه هدف PHP برای تحلیل استاتیک.
    phpVersion: 80100
    paths:
        - src
        - api
        # مسیر پنل مدیریت لایسنس.
        - Lic
        # مسیر داشبورد مانیتورینگ.
        - Monitoring
        # اسکریپت‌ها و فایل‌های ریشه جهت تحلیل استاتیک.
        - scripts
        - User
        - config
        - PermissionManager.php
        - SessionManager.php
        - check_signature.php
        - check_update.php
        - export_schema.php
        - file_manager.php
        - get_csrf_token.php
        - get_license_info.php
        - jdf.php
        - update_config.php
        - validate_license.php
    excludePaths:
        - vendor/*
    tmpDir: build/phpstan
    # فایل‌های کمکی خارج از PSR-4 جهت اسکن توابع و کلاس‌های عمومی.
    scanFiles:
        - jdf.php
        - SessionManager.php
    # فایل راه‌اندازی اولیه جهت تعریف ثابت‌ها و بارگذاری بدون اتصال پایگاه داده.
    bootstrapFiles:
        - src/bootstrap.php
