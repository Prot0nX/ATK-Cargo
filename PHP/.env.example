# ATK-Cargo Environment Configuration Example
# این فایل الگوی متغیرهای محیطی سیستم است. کپی آن با نام .env ایجاد و مقادیر آن تنظیم شود.

APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=Asia/Tehran

# تنظیمات اتصال به پایگاه داده
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=atk_cargo

# کلیدها و رمزهای عبور مدیریتی
# این مقدار باید هش bcrypt رمز عبور واقعی پنل PermissionManager.php باشد؛
# اینجا نباید هیچ هش واقعی قرار گیرد (فایل .env.example در گیت کامیت می‌شود).
# برای تولید هش رمز دلخواه:
#   php -r "echo password_hash('YOUR_PASSWORD_HERE', PASSWORD_BCRYPT);"
ADMIN_PASSWORD_HASH=

# مسیر fallback ورود با رمز متن‌خام/SHA-256 مستقیم در دیتابیس (سیستم بسیار
# قدیمی، پیش از bcrypt) — DEEP_CODE_REVIEW.md Phase1.4. به‌طور پیش‌فرض
# غیرفعال است. قبل از true کردن، حتماً بررسی کنید چند کاربر هنوز مهاجرت
# نکرده‌اند:
#   SELECT COUNT(*) FROM Users WHERE password NOT LIKE '$2y$%' AND password NOT LIKE '$2a$%';
# اگر صفر بود، این متغیر و بلوک مربوطه در UserService.php را کامل حذف کنید؛
# اگر نبود، فقط برای یک بازه‌ی زمانی محدود (مهلت اعلام‌شده به کاربران) true
# بگذارید.
ALLOW_LEGACY_PLAINTEXT_LOGIN=false

# کلید API چک آپدیت (check_update.php) — باید با مقدار برگردانده‌شده توسط
# Secrets.getApiKey() در اپ اندروید (app/src/main/cpp/secrets.cpp) یکسان باشد.
UPDATE_CHECK_API_KEY=

# اعلان فوری تلگرام برای رویدادهای امنیتی بحرانی (REFRESH_TOKEN_REUSE_DETECTED،
# قفل‌شدن حساب/IP پس از تلاش‌های ناموفق ورود) — SecurityAlerter.php.
# اختیاری: اگر خالی بماند، این قابلیت کاملاً غیرفعال است (فقط در لاگ ثبت می‌شود).
# برای فعال‌سازی: یک بات با @BotFather بسازید و chat_id مقصد (کاربر یا گروه) را بگیرید.
SECURITY_ALERT_TELEGRAM_BOT_TOKEN=
SECURITY_ALERT_TELEGRAM_CHAT_ID=
