# فایل نمونه پیکربندی متغیرهای محیطی سیستم ATK-Cargo.

APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=Asia/Tehran

# تنظیمات اتصال به پایگاه داده.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=atk_cargo

# هش bcrypt رمز عبور پنل مدیریت دسترسی‌ها (PermissionManager.php).
ADMIN_PASSWORD_HASH=

# هش bcrypt رمز عبور پنل مدیریت لایسنس (PHP/Lic)؛ در صورت خالی بودن ورود غیرفعال است.
LIC_ADMIN_PASSWORD_HASH=

# مدت‌زمان انقضای بی‌کاری نشست پنل لایسنس به ثانیه (پیش‌فرض ۱۸۰۰ ثانیه).
LIC_SESSION_IDLE_TIMEOUT=1800

# هش bcrypt رمز عبور داشبورد مانیتورینگ (PHP/Monitoring)؛ در صورت خالی بودن ورود غیرفعال است.
MONITORING_ADMIN_PASSWORD_HASH=

# مدت‌زمان انقضای بی‌کاری نشست داشبورد مانیتورینگ به ثانیه (پیش‌فرض ۱۸۰۰ ثانیه).
MONITORING_SESSION_IDLE_TIMEOUT=1800

# هش bcrypt رمز عبور پنل گزارش آماری کوتاژ (PHP/Quota_Reports)؛ در صورت خالی بودن ورود غیرفعال است.
QUOTA_REPORTS_ADMIN_PASSWORD_HASH=

# مدت‌زمان انقضای بی‌کاری نشست پنل گزارش کوتاژ به ثانیه (پیش‌فرض ۱۸۰۰ ثانیه).
QUOTA_REPORTS_SESSION_IDLE_TIMEOUT=1800

# هش bcrypt رمز عبور پنل مدیریت کاربران آنلاین (PHP/User)؛ در صورت خالی بودن ورود غیرفعال است.
ONLINE_USERS_ADMIN_PASSWORD_HASH=

# مدت‌زمان انقضای بی‌کاری نشست پنل مدیریت کاربران آنلاین به ثانیه (پیش‌فرض ۱۸۰۰ ثانیه).
ONLINE_USERS_SESSION_IDLE_TIMEOUT=1800

# کلید API بررسی به‌روزرسانی اپلیکیشن (هماهنگ با کلاینت اندروید).
UPDATE_CHECK_API_KEY=

# اطلاعات ارسال هشدارهای امنیتی بحرانی به تلگرام (اختیاری).
SECURITY_ALERT_TELEGRAM_BOT_TOKEN=
SECURITY_ALERT_TELEGRAM_CHAT_ID=
