# ATK-Cargo Environment Configuration Example
# این فایل الگوی متغیرهای محیطی سیستم است. کپی آن با نام .env ایجاد و مقادیر آن تنظیم شود.

APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=Asia/Tehran

# تنظیمات اتصال به پایگاه داده
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=atk_cargo

# کلیدها و رمزهای عبور مدیریتی
# هش پیش‌فرض زیر مربوط به کلمه عبور ادمین است
ADMIN_PASSWORD_HASH=$2y$10$bUbu4IBE6ZJKpLL5lxc9puyUEUJg3o9F/zzI896I2U6vUPA5OjI.S
