# جلوگیری از دسترسی مستقیم HTTP به فایل‌های لاگ (proxy_access.log،
# loginlimit_*.json و غیره) — DEEP_CODE_AUDIT.md #Phase1.7. سازگار با
# Apache 2.2 (mod_access_compat) و 2.4. این علاوه بر قانون
# DirectoryMatch در .htaccess ریشه‌ی PHP/ است، نه جایگزین آن — دفاع لایه‌ای
# در صورتی که AllowOverride در سطح Apache روی این هاست محدودتر از انتظار باشد.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
