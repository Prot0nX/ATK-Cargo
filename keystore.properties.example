# کپی این فایل با نام keystore.properties (در ریشه‌ی پروژه، در git کامیت نمی‌شود)
# و مقادیر واقعی کیستور امضای release را وارد کنید — DEEP_CODE_AUDIT.md.
# جایگزین: به‌جای این فایل می‌توانید متغیرهای محیطی KEYSTORE_PATH / KEYSTORE_PASSWORD /
# KEY_ALIAS / KEY_PASSWORD را در CI تنظیم کنید (app/build.gradle.kts هر دو را می‌خواند).

# مسیر مطلق یا نسبی به ریشه‌ی پروژه (همین پوشه‌ای که این فایل در آن است)
storeFile=/absolute/path/to/release.jks
storePassword=
keyAlias=
keyPassword=
