# Gradle files
.gradle/
build/

# ProGuard/R8 mapping archive (~100MB+ per release, too large for git — back up externally per release)
mapping-archive/

# Local configuration file (sdk path, etc)
local.properties

# Log/OS Files
*.log

# Android Studio generated files and folders
captures/
.externalNativeBuild/
.cxx/
*.apk
output.json

# IntelliJ
*.iml
.idea/
misc.xml
deploymentTargetDropDown.xml
render.experimental.xml

# Keystore files
*.jks
*.keystore
keystore.properties

# Google Services (e.g. APIs or Firebase)
google-services.json

# Android Profiling
*.hprof
*.salive
*.dm

# Environment / Secret Files
.env
*.env

# سرور info dump (DEEP_CODE_AUDIT.md) — شامل نسخه‌های نرم‌افزار سرور، cron، پیکربندی PHP
php_server_info_*.txt

# PHP composer dependencies — vendor/ لایو در web root است و نباید کامیت شود
# (DEEP_CODE_AUDIT.md #Phase2.2). deploy باید composer install --no-dev اجرا کند.
# .htaccess داخل vendor/ (Phase1.7) عمداً استثنا شده — باید کامیت/deploy شود.
/PHP/vendor/*
!/PHP/vendor/.htaccess

# PHP runtime state (rate-limit/login-lock/session-activity/crash-report
# فایل‌ها) — تولیدشده در زمان اجرا، نه کد منبع. .htaccess محافظتی هر پوشه
# عمداً استثنا شده.
/PHP/log/*
!/PHP/log/.htaccess
/PHP/logs/*
!/PHP/logs/.htaccess

/app/release/baselineProfiles

# خروجی گراف graphify — اسنپ‌شات‌های روزانه و ~۹۷ مگابایت، نباید کامیت شود
# (DEEP_CODE_AUDIT.md فاز۳ #۳۰). فقط محلی بماند، هرکس با graphify update . خودش می‌سازد.
/graphify-out/

/app/release/baselineProfiles
php_server_info.txt
