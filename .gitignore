# فایل‌ها و پوشه‌های خروجی بیلد گریدل.
.gradle/
build/
app/build/
.cxx/
**/build/
.kotlin/
app/release/



# آرشیو مپینگ ProGuard و R8 برای ریلیزها.
mapping-archive/

# فایل‌های پیکربندی محلی محیط توسعه (مانند مسیر SDK).
local.properties

# فایل‌های لاگ و فایل‌های موقت سیستم‌عامل.
*.log
.DS_Store
Thumbs.db

# فایل‌ها و پوشه‌های تولیدشده توسط Android Studio و IntelliJ.
.idea/
*.iml
.idea/modules/
.idea/caches/
.idea/libraries/

# تنظیمات محیط کاربری در IDE.
.idea/workspace.xml
.idea/tasks.xml
.idea/usage.statistics.xml
.idea/shelf/
.idea/assetWizardSettings.xml
.idea/deploymentTargetDropDown.xml

# فایل‌های کلید و امضای دیجیتال.
*.jks
*.keystore
keystore.properties

# پیکربندی سرویس‌های Google.
google-services.json

# فایل‌های پروفایلینگ عملکرد اندروید.
captures/
*.hprof

# فایل‌های محیطی و محرمانه‌ها.
.env
.env.local

# فایل‌های اطلاعات سرور و گزارش‌های سیستمی.
server_info.json

# وابستگی‌های Composer در PHP (به استثنای فایل‌های htaccess محافظتی).
PHP/vendor/*
!PHP/vendor/.htaccess

# فایل‌های وضعیت و نشست‌های موقت PHP در زمان اجرا.
PHP/log/*
!PHP/log/.htaccess
PHP/logs/*
!PHP/logs/.htaccess

# فایل‌های پشتیبان دیتابیس تولیدشده توسط پنل PHP/MySQL_Manager — هرگز نباید وارد گیت شوند.
PHP/storage/mysql_backups/*
!PHP/storage/mysql_backups/.gitkeep

# فایل‌های خروجی و کش PHPStan.
PHP/build/

# پایگاه داده محلی SQLite.
*.db
*.sqlite

# خروجی گراف دانش و اسنپ‌شات‌های ابزار graphify.
graphify-out/
